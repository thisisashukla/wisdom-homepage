+export async function correctStance(day: number, correction: Correction): Promise<CorrectionResult> {
+  if (!canCorrect(day)) return { ok: false };
+  const s = useJourneyStore.getState();
+  const sit = s.situation!;
+  const w = weekOfDay(s, day)!;
+  const d = w.days.find((x) => x.day === day)!;
+  const fromDay = d.day_in_week ?? day - (w.week - 1) * 7;
+  useJourneyStore.getState().setCorrection(correction);
