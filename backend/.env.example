# Sarvam AI
SARVAM_API_KEY=sk_xxx...

# Paths
# Absolute path to sanscripts/data/processed_data_v2/
CORPUS_DIR=/path/to/sanscripts/data/processed_data_v2

# Where to cache the built BGE-M3 numpy index (created on first run)
INDEX_CACHE_DIR=./data

# Model
EMBED_MODEL=BAAI/bge-m3
SARVAM_MODEL=sarvam-30b

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://wisdomquotes.in

# ── Verse of the Day ──────────────────────────────────────────────────────────
# Supabase project credentials (verse_of_day table is written by the backend cron)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# Admin key to protect POST /api/v1/verse-of-day/generate
# Set to any random secret; pass as X-Admin-Key header in the cron request
ADMIN_KEY=change-me-to-a-random-secret

# ── Plans (/recommend/hook, /recommend/preview, /recommend/plan) ──────────────
# LLM deadline for reading the person; past it the deterministic reading is used.
UNDERSTAND_TIMEOUT_S=7
# Short second pass that reorders the top hooks and picks the story; skipped when
# the request has used up REQUEST_BUDGET_S.
RERANK_TIMEOUT_S=3.5
REQUEST_BUDGET_S=10
# Optional LLM labels of each verse's plan job (scripts/label_verse_roles.py)
VERSE_ROLES_PATH=./data/taxonomy/verse_roles.json
