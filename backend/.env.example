# Sarvam AI
SARVAM_API_KEY=sk_xxx...

# Self-contained corpus: embeddings.npy + verses.json
DATA_DIR=./data

# Optional local BGE-M3 weights. Leave empty to use the Hugging Face cache.
MODEL_DIR=

# Model
EMBED_MODEL=BAAI/bge-m3
SARVAM_MODEL=sarvam-105b

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://wisdomquotes.in

# ── Verse of the Day ──────────────────────────────────────────────────────────
# Supabase project credentials (verse_of_day table is written by the backend cron)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# Admin key to protect POST /api/v1/verse-of-day/generate
# Set to any random secret; pass as X-Admin-Key header in the cron request
ADMIN_KEY=change-me-to-a-random-secret

# ── Wisdom mobile daily reflection ───────────────────────────────────────────
# Speech-to-text and spoken reflection audio. Text reasoning and verse
# selection use the existing Sarvam + BGE-M3 stack above.
OPENAI_API_KEY=sk_xxx...
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_LANGUAGE=en-IN

# RevenueCat server API + webhook authentication.
REVENUECAT_SECRET_API_KEY=sk_xxx...
REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer replace-with-a-long-random-secret

# Website Sanskrit recitation. Keep `stub` unless one provider is configured.
VAGDHENU_BACKEND=stub
VAGDHENU_HF_SPACE_ID=prathoshap/vagdhenu-demo
VAGDHENU_HF_API_NAME=/predict
VAGDHENU_HTTP_URL=
VAGDHENU_HTTP_AUTH=
VAGDHENU_HTTP_TIMEOUT=120
