# URL of the Wisdom search backend (FastAPI)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ── "Your verse" funnel ──────────────────────────────────────────────
# Backend the hero calls server-side (defaults to the production API)
WISDOM_API_URL=https://wisdom-homepage-2tf6-neon.vercel.app
# Firebase project whose Google sign-in tokens the API routes accept
FIREBASE_PROJECT_ID=wisdom-homepage
# App Store Connect provider token for campaign links (Analytics → Campaign Generator)
NEXT_PUBLIC_APP_STORE_PT=

# ── ₹89/week web plan (Razorpay Subscriptions) ───────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
# Set to 1 locally to skip the paywall while testing the plan view
WEB_PLAN_FREE=

# ── Supabase (leads + subscriptions; migration 004_web_funnel.sql) ───
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
