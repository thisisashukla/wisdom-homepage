/* Homepage v3 additions. Same palette and type as home.css. */

/* Hero: room for the verse widget */
.hero.hero-immersive.hero-v3 .hero-content { max-width: 640px; }
.hero.hero-immersive.hero-v3 h1 { font-size: clamp(32px, 4.4vw, 54px); margin-bottom: 16px; }
.hero.hero-immersive.hero-v3 .hero-sub { margin-bottom: 24px; }
.hero.hero-immersive.hero-v3 .hero-secondary-nav { display: flex; flex-wrap: wrap; gap: 8px 12px; margin-top: 26px; font-size: 14px; }
@media (max-width: 720px) {
  .hero.hero-immersive.hero-v3 { min-height: auto; padding-top: 24vh; }
  .hero.hero-immersive.hero-v3 .hero-inner { padding-top: 24px; }
  .hero.hero-immersive.hero-v3 .hero-sub { font-size: 14.5px; }
}

/* Section heads (left-aligned, not everything centred) */
.sec-head { max-width: 720px; margin-bottom: 34px; }
.sec-head .heading { margin: 0 0 12px; text-align: left; }
.sec-head .subtext { margin: 0; text-align: left; }

/* One verse, three notes: real output */
.notes-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; background: var(--bg-card); }
.note-card { padding: 26px 26px 24px; display: flex; flex-direction: column; }
.note-card + .note-card { border-left: 1px solid var(--border); }
.note-label { font-size: 10.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-dimmer); margin-bottom: 6px; }
.note-text { font-size: 14.5px; line-height: 1.55; color: var(--text); font-style: italic; margin-bottom: 18px; }
.note-reply { font-family: "Playfair Display", Georgia, serif; font-size: 17px; line-height: 1.5; color: var(--gold-light); margin-bottom: 18px; }
.note-practice { font-size: 14px; line-height: 1.6; color: var(--text-dim); margin: 0; }
.notes-foot { margin-top: 18px; font-size: 13px; color: var(--text-dimmer); max-width: 760px; line-height: 1.6; }
.notes-foot a { color: var(--gold-light); font-weight: 600; }
@media (max-width: 900px) { .notes-grid { grid-template-columns: 1fr; } .note-card + .note-card { border-left: 0; border-top: 1px solid var(--border); } }

/* Seven days: plan + offer */
.seven { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); gap: 56px; align-items: center; }
.seven-text .heading { text-align: left; margin: 0 0 14px; }
.seven-text .subtext { text-align: left; margin: 0 0 26px; max-width: 620px; }
.offers { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
.offer { padding: 20px; border-radius: 14px; border: 1px solid var(--border); background: var(--bg-card); display: flex; flex-direction: column; gap: 8px; }
.offer h3 { font-family: "Playfair Display", Georgia, serif; font-size: 19px; color: var(--gold-light); }
.offer p { font-size: 14px; line-height: 1.55; color: var(--text-dim); }
.offer .offer-price { color: var(--text); font-weight: 500; flex: 1; }
.offer a { align-self: flex-start; margin-top: 6px; }
.seven-note { margin-top: 16px; font-size: 13px; color: var(--text-dimmer); }
.seven-art img { width: 100%; max-width: 320px; height: auto; display: block; margin: 0 auto; border-radius: 22px; border: 1px solid var(--border); }
@media (max-width: 900px) {
  .seven { grid-template-columns: 1fr; gap: 32px; }
  .seven-art { order: -1; }
  .seven-art img { max-width: 240px; }
}
@media (max-width: 600px) { .offers { grid-template-columns: 1fr; } .offer a { align-self: stretch; justify-content: center; } }

/* Sources */
.sources-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; border-top: 1px solid var(--border); padding-top: 26px; }
.sources-grid h3 { font-family: "Playfair Display", Georgia, serif; font-size: 19px; color: var(--gold-light); margin-bottom: 8px; }
.sources-grid p { font-size: 15px; line-height: 1.65; color: var(--text-dim); }
.sources-grid a { color: var(--gold-light); }
.sources-review { margin: 36px 0 0; padding-left: 20px; border-left: 2px solid rgba(245, 201, 106, 0.45); max-width: 720px; }
.sources-review blockquote { font-family: "Playfair Display", Georgia, serif; font-style: italic; font-size: clamp(17px, 2vw, 20px); line-height: 1.5; color: var(--text); }
.sources-review figcaption { margin-top: 10px; font-size: 13px; color: var(--text-dimmer); }
@media (max-width: 820px) { .sources-grid { grid-template-columns: 1fr; gap: 22px; } }

.footer-crisis { font-size: 12px; color: var(--text-dimmer); margin-top: 4px; }

/* App v3 */
.app-v3-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; max-width: 1000px; margin: 0 auto; }
.app-v3-card { text-align: left; }
.app-v3-card img {
  width: 100%;
  height: auto;
  aspect-ratio: 640 / 1391;
  object-fit: cover;
  object-position: top;
  max-height: 460px;
  border-radius: 18px;
  border: 1px solid var(--border);
  display: block;
  margin-bottom: 14px;
  background: var(--bg-warm);
}
.app-v3-card h3 { font-family: "Playfair Display", Georgia, serif; font-size: 20px; color: var(--gold-light); margin-bottom: 6px; }
.app-v3-card p { font-size: 14.5px; line-height: 1.6; color: var(--text-dim); }
.app-v3-actions { display: flex; justify-content: center; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 34px; }
@media (max-width: 820px) {
  .app-v3-grid { grid-template-columns: 1fr; gap: 28px; max-width: 420px; }
  .app-v3-card img { max-height: 380px; }
}

/* Gita for life */
.gita-for-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 12px; }
.gita-for-tile {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 18px 18px 16px;
  border-radius: 12px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  transition: border-color 0.15s, transform 0.15s;
}
.gita-for-tile:hover { border-color: var(--gold-light); transform: translateY(-1px); }
.gita-for-label { font-family: "Playfair Display", Georgia, serif; font-size: 18px; font-weight: 700; color: var(--gold-light); }
.gita-for-count { font-size: 12.5px; color: var(--text-dimmer); }

/* Today's verse actions */
.today-actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 18px; }

/* Compact library */
.library-row {
  max-width: 1080px;
  margin: 26px auto 0;
  padding: 14px 18px;
  border-radius: 10px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  display: flex;
  flex-wrap: wrap;
  gap: 8px 20px;
  align-items: center;
}
.library-label { font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-dimmer); }
.library-row a { font-size: 13.5px; color: var(--gold-light); opacity: 0.88; }
.library-row a:hover { opacity: 1; }
.hindi-callout {
  max-width: 1080px;
  margin: 18px auto 0;
  padding: 26px 28px;
  border-radius: 16px;
  background: linear-gradient(135deg, rgba(245, 201, 106, 0.08) 0%, rgba(200, 136, 30, 0.04) 100%);
  border: 1px solid rgba(245, 201, 106, 0.28);
  display: flex;
  flex-wrap: wrap;
  gap: 18px 24px;
  align-items: center;
  justify-content: space-between;
}
.hindi-callout-head { font-family: "Playfair Display", var(--font-noto-devanagari), Georgia, serif; font-size: clamp(20px, 2.3vw, 26px); color: var(--gold-light); margin-bottom: 4px; }
.hindi-callout-sub { font-size: 14.5px; color: var(--text-dim); }
.blog-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; max-width: 1080px; margin: 18px auto 0; }
.blog-row-card { display: flex; flex-direction: column; gap: 8px; padding: 20px; border-radius: 14px; background: var(--bg-card); border: 1px solid var(--border); }
.blog-row-card h3 { font-family: "Playfair Display", Georgia, serif; font-size: 17px; line-height: 1.35; color: var(--text); }
.blog-row-card p { font-size: 13.5px; line-height: 1.55; color: var(--text-dim); flex: 1; }
.blog-row-card span { font-size: 12.5px; color: var(--gold-light); }
@media (max-width: 820px) { .blog-row { grid-template-columns: 1fr; } }

/* /app */
.app-screens {
  display: flex;
  gap: 14px;
  overflow-x: auto;
  padding: 44px max(16px, calc((100vw - 1100px) / 2)) 8px;
  scroll-snap-type: x mandatory;
  scrollbar-width: thin;
}
.app-screens img { flex: 0 0 auto; width: 210px; height: auto; border-radius: 16px; border: 1px solid var(--border); scroll-snap-align: start; }
.app-steps { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; max-width: 1080px; margin: 0 auto; padding: 0; }
.app-steps li { padding: 22px 20px; border-radius: 14px; background: var(--bg-card); border: 1px solid var(--border); }
.app-step-n { display: inline-flex; width: 28px; height: 28px; align-items: center; justify-content: center; border-radius: 50%; background: var(--gold); color: #1a0606; font-weight: 700; font-size: 13px; margin-bottom: 12px; }
.app-steps h3 { font-family: "Playfair Display", Georgia, serif; font-size: 18px; color: var(--gold-light); margin-bottom: 6px; }
.app-steps p { font-size: 14.5px; line-height: 1.6; color: var(--text-dim); }
@media (max-width: 900px) { .app-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 560px) { .app-steps { grid-template-columns: 1fr; } .app-screens img { width: 170px; } }

/* Footer links wrap on phones instead of pushing the page sideways */
.footer-links { flex-wrap: wrap; row-gap: 8px; }

/* ── Week steps (numbered row, connected) ── */
.week { list-style: none; padding: 0; margin: 0 0 26px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; position: relative; }
.week::before { content: ""; position: absolute; left: 22px; right: 22px; top: 22px; height: 1px; background: linear-gradient(90deg, rgba(245, 201, 106, 0.55), rgba(245, 201, 106, 0.12)); transform-origin: left center; }
.week li { position: relative; padding-right: 16px; display: flex; flex-direction: column; gap: 10px; }
.week-n { flex-shrink: 0; width: 44px; height: 44px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: #1a0707; border: 1px solid rgba(245, 201, 106, 0.55); color: var(--gold-light); font-family: "Playfair Display", Georgia, serif; font-size: 15px; font-weight: 700; position: relative; }
.week-t { font-size: 14.5px; line-height: 1.55; color: var(--text-dim); }
@media (max-width: 720px) {
  .week { grid-template-columns: 1fr; gap: 16px; }
  .week::before { left: 22px; right: auto; top: 22px; bottom: 22px; width: 1px; height: auto; background: linear-gradient(180deg, rgba(245, 201, 106, 0.55), rgba(245, 201, 106, 0.12)); transform-origin: center top; }
  .week li { flex-direction: row; align-items: center; gap: 14px; padding-right: 0; }
}

/* ── Single-quote band ── */
.sources-review { margin: 44px auto 0; padding: 0; border-left: 0; max-width: 760px; text-align: center; }
.sources-review blockquote { font-size: clamp(20px, 2.4vw, 26px); line-height: 1.45; }
.sources-review blockquote::before { content: "“"; display: block; font-size: 64px; line-height: 0.6; color: var(--gold); margin-bottom: 14px; font-style: normal; }

/* ── FAQ: heading left, questions right ── */
.faq-split { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 48px; align-items: start; }
.faq-split .faq-list { margin: 0; max-width: none; }
@media (max-width: 900px) { .faq-split { grid-template-columns: 1fr; gap: 8px; } }

/* ── Closing band over chapter art ── */
.final-band-wrap { padding: 24px max(16px, 28px) 88px; }
.final-band { position: relative; max-width: var(--max); margin: 0 auto; border-radius: 28px; overflow: hidden; border: 1px solid rgba(245, 201, 106, 0.25); min-height: 380px; display: flex; align-items: center; justify-content: center; text-align: center; }
.final-band-art { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
.final-band-scrim { position: absolute; inset: 0; background: radial-gradient(ellipse at center, rgba(18, 5, 5, 0.62) 0%, rgba(18, 5, 5, 0.86) 70%); }
.final-band-inner { position: relative; padding: 64px 24px; max-width: 640px; }
.final-band-inner h2 { font-family: "Playfair Display", Georgia, serif; font-size: clamp(30px, 4vw, 46px); line-height: 1.12; color: var(--gold-light); margin-bottom: 12px; }
.final-band-inner h2 em { color: #fff; }
.final-band-inner p { color: rgba(248, 240, 220, 0.85); margin-bottom: 26px; font-size: 16px; }
@media (max-width: 600px) { .final-band { border-radius: 20px; min-height: 320px; } .final-band-wrap { padding: 8px 16px 64px; } }

/* ══ Motion system (LottieFiles motion-design skill) ═════════════════════
   Personality: Premium / calm. Signature easing (0.4,0,0.2,1), no overshoot.
   Durations: quick 160ms (feedback), standard 500ms (entrances), slow 900ms.
   Entrance: fade + rise 14px + scale 98.5%→100%. Stagger budget <= 420ms.
   Elements are visible without JS: hiding only applies under html.motion. */
:root {
  --ease: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-out: cubic-bezier(0.2, 0, 0, 1);
  --t-quick: 160ms;
  --t-std: 500ms;
  --t-slow: 900ms;
}
.motion .rv { opacity: 0; transform: translateY(14px) scale(0.985); }
.motion .rv.in {
  opacity: 1;
  transform: none;
  transition: opacity var(--t-std) var(--ease), transform var(--t-std) var(--ease);
  transition-delay: var(--d, 0ms);
}

/* Hero entrance: replace the overshoot curves with the signature easing.
   Primary = headline; secondary = eyebrow/sub/widget follow through. */
.hero.hero-v3 .hero-eyebrow { animation: heroUp var(--t-std) var(--ease) both; animation-delay: 0ms; }
.hero.hero-v3 h1 { animation: heroUp 600ms var(--ease) both; animation-delay: 80ms; }
.hero.hero-v3 .hero-sub { animation: heroUp var(--t-std) var(--ease) both; animation-delay: 180ms; }
.hero.hero-v3 .yv { animation: heroUp var(--t-std) var(--ease) both; animation-delay: 260ms; }
.hero.hero-v3 .hero-secondary-nav { animation: heroFade var(--t-std) var(--ease) both; animation-delay: 360ms; }
/* Ambient layer: the art drifts and the glow breathes, slowly enough to go unnoticed. */
.hero.hero-v3 .hero-bg { animation: hero-drift 28s var(--ease) infinite alternate; }
.hero.hero-v3 .hero-glow { animation: glow-breathe 9s ease-in-out infinite alternate; }
@keyframes hero-drift { from { transform: scale(1.02); } to { transform: scale(1.07) translateY(-1%); } }
@keyframes glow-breathe { from { opacity: 0.65; } to { opacity: 1; } }

/* Steps: the connecting line draws after the numbers land. */
.motion .week::before { transform: scaleX(0); transition: transform var(--t-slow) var(--ease) 240ms; }
.motion .week.drawn::before { transform: scaleX(1); }
@media (max-width: 720px) {
  .motion .week::before { transform: scaleY(0); }
  .motion .week.drawn::before { transform: scaleY(1); }
}

/* Feedback: tiles and cards respond within 160ms. */
.gita-for-tile, .blog-row-card, .chapter-tile { transition: transform var(--t-quick) var(--ease-out), border-color var(--t-quick) var(--ease-out); }
.blog-row-card:hover { transform: translateY(-2px); border-color: rgba(245, 201, 106, 0.45); }

@media (prefers-reduced-motion: reduce) {
  .motion .rv, .motion .rv.in { transform: none; transition: opacity 250ms linear; }
  .hero.hero-v3 .hero-bg, .hero.hero-v3 .hero-glow { animation: none; }
  .hero.hero-v3 .hero-eyebrow, .hero.hero-v3 h1, .hero.hero-v3 .hero-sub, .hero.hero-v3 .yv, .hero.hero-v3 .hero-secondary-nav { animation: heroFade 250ms linear both; }
  .motion .week::before { transform: none; transition: none; }
}

/* Hero v4: headline, one line, one button. The question replaces the subtitle once opened. */
.hero.hero-immersive.hero-v3 h1 { font-size: clamp(36px, 5.2vw, 64px); line-height: 1.04; margin-bottom: 18px; }
.hero.hero-immersive.hero-v3 .hero-sub { font-size: clamp(16px, 1.6vw, 19px); max-width: 30em; margin-bottom: 28px; }
.hero-content:has(.yv:not([data-stage="intro"])) .hero-sub { display: none; }
.hero.hero-v3 .yv { max-width: 560px; }
@media (max-width: 720px) {
  .hero.hero-immersive.hero-v3 { padding-top: 30vh; }
  .hero.hero-immersive.hero-v3 h1 { font-size: clamp(34px, 10vw, 44px); }
}

/* ══ Plan preview (section 2): pick a situation, see the real week ═══════
   Same card language as the hero verse card: dark glass, gold hairline,
   Playfair line, Devanagari in gold-light. One button under the card. */
.pp { max-width: 1000px; }
.pp-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
.pp-tab {
  font: inherit; font-size: 14.5px; font-weight: 500; color: var(--text-dim);
  background: transparent; border: 1px solid var(--border); border-radius: 999px;
  padding: 9px 16px; cursor: pointer;
  transition: border-color var(--t-quick) var(--ease-out), background var(--t-quick) var(--ease-out), color var(--t-quick) var(--ease-out), transform 120ms var(--ease-out);
}
.pp-tab:hover { border-color: rgba(245, 201, 106, 0.5); color: var(--text); }
.pp-tab:active { transform: scale(0.97); }
.pp-tab:focus-visible { outline: 2px solid var(--gold-light); outline-offset: 2px; }
.pp-tab.is-on { background: var(--gold-dim); border-color: var(--gold); color: var(--gold-light); }

.pp-card {
  position: relative; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
  border: 1px solid var(--border); border-radius: 18px; background: var(--bg-card); overflow: hidden;
}
.pp-card::before {
  content: ""; position: absolute; top: 0; left: 26px; right: 26px; height: 1px;
  background: linear-gradient(90deg, rgba(245, 201, 106, 0), rgba(245, 201, 106, 0.9), rgba(245, 201, 106, 0));
}
.pp-day1 { padding: 30px 30px 28px; background: rgba(200, 136, 30, 0.05); border-right: 1px solid var(--border); }
.pp-week { padding: 26px 30px 24px; }

.pp-meta { font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-dimmer); }
.pp-meta a { color: inherit; text-decoration: underline; text-decoration-color: rgba(245, 201, 106, 0.35); text-underline-offset: 3px; }
.pp-meta a:hover { color: var(--gold-light); }
.pp-day1 .pp-meta { margin-bottom: 14px; }
.pp-dn { color: var(--gold-light); }
.pp-sa { font-family: var(--font-noto-devanagari), "Noto Sans Devanagari", serif; font-size: 18px; line-height: 1.7; color: var(--gold-light); margin: 0 0 12px; }
.pp-line { font-family: "Playfair Display", Georgia, serif; font-size: clamp(20px, 2.3vw, 24px); line-height: 1.35; color: #fff; margin: 0 0 16px; }
.pp-for { font-size: 15px; line-height: 1.6; color: var(--text-dim); margin: 0; padding-top: 14px; border-top: 1px solid var(--border); }
.pp-for span { display: block; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold); margin-bottom: 4px; }

.pp-week-title { font-size: 13px; color: var(--text-dimmer); margin-bottom: 14px; }
.pp-week-title em { font-family: "Playfair Display", Georgia, serif; font-style: italic; font-size: 16px; color: var(--gold-light); }
.pp-days { list-style: none; margin: 0; padding: 0; position: relative; display: grid; gap: 14px; }
.pp-days::before {
  content: ""; position: absolute; left: 14px; top: 14px; bottom: 14px; width: 1px;
  background: linear-gradient(180deg, rgba(245, 201, 106, 0.55), rgba(245, 201, 106, 0.12)); transform-origin: center top;
}
.pp-days li { display: grid; grid-template-columns: 29px minmax(0, 1fr); gap: 14px; align-items: start; position: relative; }
.pp-n {
  width: 29px; height: 29px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;
  background: #1a0707; border: 1px solid rgba(245, 201, 106, 0.55); color: var(--gold-light);
  font-family: "Playfair Display", Georgia, serif; font-size: 13px; font-weight: 700; position: relative;
}
.pp-days .pp-meta { font-size: 10.5px; margin: 5px 0 3px; }
.pp-l { font-size: 14.5px; line-height: 1.5; color: var(--text); margin: 0; } /* never clamp: lines are shown whole, as the sources section promises */
.pp-days li.is-story .pp-n { background: var(--gold); color: #1a0606; border-color: var(--gold); }
.pp-days li.is-story .pp-l { font-family: "Playfair Display", Georgia, serif; font-style: italic; color: var(--gold-light); }

.pp-cta { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 18px; margin-top: 22px; }
.pp-fine { margin: 0; font-size: 13.5px; color: var(--text-dimmer); }
.pp-foot { margin: 14px 0 0; font-size: 12.5px; line-height: 1.6; color: var(--text-dimmer); }
.pp .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

@media (max-width: 820px) {
  .pp-card { grid-template-columns: 1fr; }
  .pp-day1 { border-right: 0; border-bottom: 1px solid var(--border); padding: 24px 20px 22px; }
  .pp-week { padding: 22px 20px 20px; }
  .pp-sa { font-size: 16.5px; }
  .pp-cta .btn-read-gita { width: 100%; justify-content: center; }
}
@media (max-width: 480px) {
  .pp-tab { font-size: 14px; padding: 8px 14px; }
}

/* Motion: on each tab the panel re-mounts. Day 1 settles first, then days
   2–7 cascade (50ms apart, 300ms budget) while the thread draws down. */
@keyframes pp-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
@keyframes pp-thread { from { transform: scaleY(0); } to { transform: scaleY(1); } }
.pp-day1 > *, .pp-week-title, .pp-days li { animation: pp-in var(--t-std) var(--ease) both; animation-delay: calc(var(--i, 0) * 50ms); }
.pp-week-title { animation-delay: 120ms; }
.pp-days li { animation-delay: calc(140ms + var(--i, 0) * 50ms); }
.pp-days::before { animation: pp-thread var(--t-slow) var(--ease) 160ms both; }
@media (prefers-reduced-motion: reduce) {
  .pp-day1 > *, .pp-week-title, .pp-days li { animation: heroFade 200ms linear both; }
  .pp-days::before { animation: none; }
  .pp-tab { transition: none; }
}

/* ══ Device plans (section 3): where you read it, what it costs ══════════
   One switch, preset to the visitor's device; one panel; one button. */
.dp { max-width: 1000px; }
.dp-switch { display: inline-flex; padding: 4px; gap: 4px; border: 1px solid var(--border); border-radius: 999px; margin-bottom: 18px; background: var(--bg-card); }
.dp-tab {
  font: inherit; font-size: 14.5px; font-weight: 500; color: var(--text-dim); background: transparent; border: 0;
  border-radius: 999px; padding: 9px 18px; cursor: pointer;
  transition: background var(--t-quick) var(--ease-out), color var(--t-quick) var(--ease-out);
}
.dp-tab:hover { color: var(--text); }
.dp-tab:focus-visible { outline: 2px solid var(--gold-light); outline-offset: 2px; }
.dp-tab.is-on { background: var(--gold); color: #1a0606; }

.dp-panel[hidden] { display: none; }
.dp-panel {
  position: relative; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); align-items: center; gap: 40px;
  padding: 30px; border: 1px solid var(--border); border-radius: 18px; background: var(--bg-card);
}
.dp-panel::before {
  content: ""; position: absolute; top: 0; left: 26px; right: 26px; height: 1px;
  background: linear-gradient(90deg, rgba(245, 201, 106, 0), rgba(245, 201, 106, 0.9), rgba(245, 201, 106, 0));
}
.dp-art-phone { height: 380px; overflow: hidden; border-radius: 18px; border: 1px solid var(--border); }
.dp-art-phone img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
.dp-art-note { padding: 22px; border-radius: 16px; border: 1px solid var(--border); background: rgba(10, 3, 3, 0.55); }
.dp-note-label { font-family: "Playfair Display", Georgia, serif; font-size: 19px; color: var(--gold-light); margin-bottom: 12px; }
.dp-note-box { font-size: 14.5px; line-height: 1.6; color: var(--text); padding: 14px 16px; border-radius: 12px; border: 1px solid rgba(245, 201, 106, 0.35); background: rgba(255, 255, 255, 0.03); min-height: 120px; }
.dp-note-label span { float: right; margin-top: 4px; font-family: Inter, sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-dimmer); }

.dp-price { font-family: "Playfair Display", Georgia, serif; font-size: clamp(28px, 3.4vw, 38px); line-height: 1.1; color: var(--gold-light); margin: 0 0 18px; }
.dp-price span { display: inline-block; vertical-align: middle; margin-left: 10px; font-family: Inter, sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gold); border: 1px solid var(--gold-border); border-radius: 999px; padding: 4px 10px; }
.dp-facts { list-style: none; margin: 0 0 24px; padding: 0; display: grid; gap: 10px; }
.dp-facts li { position: relative; padding-left: 20px; font-size: 15.5px; line-height: 1.55; color: var(--text); }
.dp-facts li::before { content: ""; position: absolute; left: 2px; top: 10px; width: 6px; height: 6px; border-radius: 50%; background: var(--gold); }
.dp-foot { margin: 14px 0 0; font-size: 13px; color: var(--text-dimmer); }

@media (max-width: 820px) {
  .dp-panel { grid-template-columns: 1fr; gap: 24px; padding: 20px; }
  .dp-art-phone { height: 260px; }
  .dp-body .btn-read-gita { width: 100%; justify-content: center; }
  .dp-switch { display: flex; }
  .dp-tab { flex: 1; padding: 9px 6px; font-size: 14px; white-space: nowrap; }
}

/* Motion: the panel swaps with one calm rise; art first, then the words. */
@keyframes dp-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
.dp-art, .dp-body > * { animation: dp-in var(--t-std) var(--ease) both; }
.dp-body > :nth-child(1) { animation-delay: 80ms; }
.dp-body > :nth-child(2) { animation-delay: 140ms; }
.dp-body > :nth-child(3) { animation-delay: 200ms; }
@media (prefers-reduced-motion: reduce) {
  .dp-art, .dp-body > * { animation: heroFade 200ms linear both; }
  .dp-tab { transition: none; }
}

/* ── v2 (20 Oct): reader link, today as an H2, which-gita, library actions ── */
.hero.hero-v3 .hero-read-link {
  display: inline-flex; align-items: center; gap: 6px; margin-top: 18px;
  font-size: 14.5px; color: var(--gold-light); text-decoration: underline;
  text-decoration-color: rgba(245, 201, 106, 0.45); text-underline-offset: 4px;
  min-height: 44px; animation: heroUp var(--t-std) var(--ease) both; animation-delay: 300ms;
}
.hero.hero-v3 .hero-read-link:hover { text-decoration-color: var(--gold-light); }
.hero.hero-v3 .hero-read-link span { transition: transform 160ms cubic-bezier(0.4, 0, 0.2, 1); }
.hero.hero-v3 .hero-read-link:hover span { transform: translateX(3px); }
@media (prefers-reduced-motion: reduce) { .hero.hero-v3 .hero-read-link { animation: heroFade 250ms linear both; } }
.hero-content:has(.yv:not([data-stage="intro"])) .hero-read-link { display: none; }

h2.today-verse-ref { margin: 0; line-height: 1.3; }

.which-gita-essay { text-align: center; margin-top: 26px; font-size: 15px; }
.which-gita-essay a { color: var(--gold-light); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(245, 201, 106, 0.45); }

.library-actions { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; margin: 0 0 28px; }
.dp-note { font-size: 14.5px; line-height: 1.55; color: var(--text-dim); margin: 0; }
